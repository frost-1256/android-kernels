# Nothing Phone (1) / SM7325 hardware enablement for Linux mainline.
#
# defconfig sets most of these to =m.  The Android boot image has no
# vendor_dlkm, so everything the device needs to get to the UI must be =y.

# --- display / GPU (sm7325 reuses sc7280/kodiak compatibles) ---------------
# DRM_MSM depends on (QCOM_OCMEM || QCOM_OCMEM=n); sm7325 has no OCMEM, and
# leaving it =m would demote DRM_MSM to a module that make Image never builds.
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_VISIONOX_RM692E5=y

# --- audio (ADSP / q6dsp; topologies are still a bring-up item) ------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y

# --- storage / USB ----------------------------------------------------------
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y

# --- SoC infrastructure -----------------------------------------------------
CONFIG_PINCTRL_SC7280=y
CONFIG_PINCTRL_SC7280_LPASS_LPI=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_WDT=y

# --- remoteproc / IPA / QRTR (modem, ADSP, CDSP, WPSS) ---------------------
# ATH11K/QCOM_IPA/QCOM_Q6V5_PAS are tristate chains: if any dependency stays
# =m the whole chain is demoted and make Image silently skips it.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_APR=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QCOM_IPA=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_RMNET=y

# --- WiFi / BT / NFC --------------------------------------------------------
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH11K=y
CONFIG_ATH11K_AHB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_NFC_NXP_NCI=y
CONFIG_NFC_NXP_NCI_I2C=y
